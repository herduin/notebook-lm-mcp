# Docker Compose environment template
# Copy this file to .env and fill in your values

# Google Cloud Configuration (REQUIRED)
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_PROJECT_NUMBER=123456789
GOOGLE_REGION=us-central1

# Absolute or relative path on the Docker host to your service account key JSON file
GOOGLE_CREDENTIALS_PATH=./service-account-key.json

# NotebookLM Configuration (REQUIRED)
NOTEBOOK_ID=your-notebook-id

# Model Configuration
MODEL=gemini-1.5-pro-002

# Health server
PORT=3000
NODE_ENV=production

# Optional HTTP API for remote access
ENABLE_HTTP_API=true
HTTP_API_PORT=3100
CORS_ORIGIN=*
# API_KEY=your-secret-api-key

# Cache Configuration (seconds)
CACHE_TTL=300

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Timeout Configuration (milliseconds)
REQUEST_TIMEOUT_MS=30000

# Security Configuration
MAX_QUESTION_LENGTH=4000

# Logging Configuration
LOG_LEVEL=info
