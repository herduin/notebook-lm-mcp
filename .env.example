# Google Cloud Configuration
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_PROJECT_NUMBER=123456789
GOOGLE_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# NotebookLM Configuration
NOTEBOOK_ID=your-notebook-id

# Model Configuration (Vertex AI)
MODEL=gemini-1.5-pro-002

# Server Configuration
PORT=3000          # Health endpoints port
MCP_PORT=3000      # MCP server port (defaults to PORT if not set)
NODE_ENV=production

# Authentication (REQUIRED for production)
API_KEY=your-secret-api-key-here  # X-API-Key header authentication (case-insensitive)

# CORS Configuration
CORS_ORIGIN=*      # Set to specific domain in production

# Cache Configuration (TTL in seconds)
CACHE_TTL=300

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Timeout Configuration (in milliseconds)
REQUEST_TIMEOUT_MS=30000

# Security Configuration
MAX_QUESTION_LENGTH=4000

# Logging Configuration
LOG_LEVEL=info

# =============================================================================
# IMPORTANT NOTES:
# =============================================================================
#
# 1. API_KEY is REQUIRED for security. Set a strong random value.
#    Generate one with: openssl rand -hex 32
#
# 2. The server uses HTTP only (no SSL). Deploy behind:
#    - Cloudflare Tunnel (recommended)
#    - Nginx/Apache reverse proxy with SSL
#    - Cloud load balancer with SSL termination
#
# 3. MCP_PORT: If not set, uses PORT value. Set separately if running
#    multiple services on different ports.
#
# 4. CORS_ORIGIN: Set to your specific domain(s) in production for security.
#
# 5. For Cloudflare Tunnels, you don't need SSL configuration on this server.
#
# =============================================================================
